{
  "name": "verdict",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-agent AI code review platform for GitHub Pull Requests",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @verdict/api",
    "dev:web": "npm run dev -w @verdict/web",
    "build": "npm run build -w @verdict/api && npm run build -w @verdict/web",
    "test": "npm run test -w @verdict/api",
    "lint": "npm run lint --workspaces --if-present",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
